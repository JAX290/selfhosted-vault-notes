# 公网域名，不要带 https:// 或路径
VAULT_DOMAIN=vault.example.com
NOTES_DOMAIN=notes.example.com
ACME_EMAIL=admin@example.com

# 仅授予 Zone / DNS / Edit 和 Zone / Zone / Read 的 Cloudflare API Token
CF_API_TOKEN=replace-with-cloudflare-api-token

# NAS 的 Tailscale IPv4 地址。Caddy 只绑定到该地址。
NAS_TAILSCALE_IP=100.64.0.10
NAS_TLS_PORT=8443

# 为每次部署生成随机长密码
JOPLIN_DB_NAME=joplin
JOPLIN_DB_USER=joplin
JOPLIN_DB_PASSWORD=replace-with-a-long-random-password

# 固定版本，确认发行说明后再升级
VAULTWARDEN_IMAGE=vaultwarden/server:1.36.0
JOPLIN_IMAGE=joplin/server:3.7.1
POSTGRES_IMAGE=postgres:17.6-alpine

# 可选：SMTP。留空时 Vaultwarden 邮件功能不可用。
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
