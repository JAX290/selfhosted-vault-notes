[Unit]
Description=NAS TLS passthrough gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=haproxy
Group=haproxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/opt/vault-notes/edge.env
ExecStartPre=/usr/sbin/haproxy -c -f /opt/vault-notes/haproxy.cfg
ExecStart=/usr/sbin/haproxy -W -db -f /opt/vault-notes/haproxy.cfg
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
