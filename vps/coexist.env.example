# VPS 上已有 Nginx/HAProxy 服务时使用。复制为 coexist.env 后填写；该文件不会提交 Git。
EDGE_BIND_ADDRESS=10.0.0.10
VAULT_DOMAIN=vault.example.com
NOTES_DOMAIN=notes.example.com
NAS_TAILSCALE_IP=100.64.0.10
NAS_TLS_PORT=8443
EXISTING_TLS_ADDRESS=127.0.0.1:443
NGINX_SITE=/etc/nginx/sites-available/existing-site
EXISTING_TEST_DOMAIN=status.example.com
EXISTING_EXPECTED_STATUS=200
